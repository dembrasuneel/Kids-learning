<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lg_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/TextAppearance.LittleGenius.Display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/games_title"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tv_games_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/games_subtitle"
            android:textColor="@color/lg_on_surface_variant"
            android:textSize="14sp" />

        <!-- Playable Daily Brain Warmup Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.LittleGenius.FlatPastelCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/pastel_peach_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/TextAppearance.LittleGenius.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/games_warmup_title"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/tv_games_quiz_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/lg_on_surface"
                    android:textSize="14sp"
                    tools:text="Class 1 Challenge • Mathematics: What is 8 + 7?" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_games_play_quiz"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:text="@string/games_warmup_cta"
                    app:backgroundTint="@color/pastel_peach_fg"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_quiz" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Interactive Game Modes -->
        <TextView
            style="@style/TextAppearance.LittleGenius.SectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Quick Mini-Challenges"
            android:textSize="18sp" />

        <!-- Math Sprint Card (Instant interactive mini-round) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_game_math_sprint"
            style="@style/Widget.LittleGenius.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="82dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_pill_rounded"
                    android:backgroundTint="@color/pastel_sky_bg">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_calculate"
                        app:tint="@color/pastel_sky_fg" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.LittleGenius.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quick Math Challenge"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to solve a fresh math puzzle for your class"
                        android:textColor="@color/lg_on_surface_variant"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/lg_on_surface_variant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Word & Audio Listen Challenge -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_game_word_listen"
            style="@style/Widget.LittleGenius.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="82dp"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_pill_rounded"
                    android:backgroundTint="@color/pastel_mint_bg">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_translate"
                        app:tint="@color/pastel_mint_fg" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.LittleGenius.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Word Pronunciation Practice"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hear vocabulary words spoken aloud clearly"
                        android:textColor="@color/lg_on_surface_variant"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_volume_up"
                    app:tint="@color/lg_on_surface_variant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
