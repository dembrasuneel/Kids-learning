<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_sheet_subject_title"
        style="@style/TextAppearance.LittleGenius.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        tools:text="Urdu Alphabet" />

    <TextView
        android:id="@+id/tv_sheet_subject_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/lg_on_surface_variant"
        android:textSize="14sp"
        tools:text="حروفِ تہجی کی پہچان" />

    <TextView
        android:id="@+id/tv_sheet_urdu_sample"
        style="@style/TextAppearance.LittleGenius.UrduSample"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_pill_rounded"
        android:backgroundTint="@color/pastel_mint_bg"
        android:gravity="center"
        android:padding="14dp"
        android:textDirection="rtl"
        android:textSize="24sp"
        android:visibility="gone"
        tools:text="میرا پیارا وطن"
        tools:visibility="visible" />

    <TextView
        style="@style/TextAppearance.LittleGenius.CardTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Included Chapters &amp; Topics"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tv_sheet_topics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/lg_on_surface"
        android:textSize="14sp"
        tools:text="• Place Value\n• Mental Addition\n• Shapes &amp; Time" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sheet_listen"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/listen_aloud"
            app:icon="@drawable/ic_volume_up" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sheet_close"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/quiz_close" />
    </LinearLayout>

</LinearLayout>
