<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_quiz_subject_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_rounded"
        android:backgroundTint="@color/pastel_peach_bg"
        android:paddingHorizontal="12dp"
        android:paddingVertical="5dp"
        android:textColor="@color/pastel_peach_fg"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="Mathematics" />

    <TextView
        android:id="@+id/tv_quiz_question"
        style="@style/TextAppearance.LittleGenius.SectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="19sp"
        tools:text="What is 8 + 7?" />

    <RadioGroup
        android:id="@+id/rg_quiz_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <RadioButton
            android:id="@+id/rb_option_0"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            tools:text="14" />

        <RadioButton
            android:id="@+id/rb_option_1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            tools:text="15" />

        <RadioButton
            android:id="@+id/rb_option_2"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            tools:text="16" />

        <RadioButton
            android:id="@+id/rb_option_3"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            tools:text="17" />
    </RadioGroup>

    <TextView
        android:id="@+id/tv_quiz_feedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Awesome! +15 Points and +1 Star earned!"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_quiz_close"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/quiz_close" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_quiz_submit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.5"
            android:text="@string/quiz_submit"
            app:cornerRadius="14dp" />
    </LinearLayout>

</LinearLayout>
