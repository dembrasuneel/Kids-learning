<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_subject_row"
    style="@style/Widget.LittleGenius.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="84dp"
        android:orientation="horizontal"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/row_icon_bg"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_pill_rounded">

            <ImageView
                android:id="@+id/iv_row_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_subject_icon"
                tools:src="@drawable/ic_translate" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_row_title"
                style="@style/TextAppearance.LittleGenius.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                tools:text="Urdu Alphabet" />

            <TextView
                android:id="@+id/tv_row_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/lg_on_surface_variant"
                android:textSize="13sp"
                tools:text="حروفِ تہجی کی پہچان" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_row"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:trackCornerRadius="6dp"
                    app:trackThickness="6dp"
                    tools:progress="50" />

                <TextView
                    android:id="@+id/tv_row_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/lg_on_surface_variant"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="50%" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/lg_on_surface_variant" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
