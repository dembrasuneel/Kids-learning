<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lg_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/lg_surface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/parent_dashboard_title"
        app:titleTextAppearance="@style/TextAppearance.LittleGenius.SectionTitle" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="24dp">

            <!-- Student Summary Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.LittleGenius.FlatPastelCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/pastel_lavender_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_parent_student_summary"
                        style="@style/TextAppearance.LittleGenius.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        tools:text="Ayan • Class 1" />

                    <TextView
                        android:id="@+id/tv_parent_time_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/lg_on_surface_variant"
                        android:textSize="14sp"
                        tools:text="14 mins today • 126 mins this week • 5 day streak" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Learning Goal & Curriculum Controls -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.LittleGenius.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.LittleGenius.CardTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/parent_daily_goal_label"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tv_parent_goal_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/lg_primary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="20 mins" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_parent_daily_goal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="5.0"
                        android:valueFrom="10.0"
                        android:valueTo="60.0"
                        tools:value="20.0" />

                    <TextView
                        style="@style/TextAppearance.LittleGenius.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/parent_curriculum_label"
                        android:textSize="15sp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_curriculum_track"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_track_islamic"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="Islamic Studies" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_track_ethics"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="Ethics &amp; Values" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Focus Topics -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.LittleGenius.FlatPastelCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/pastel_peach_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TextAppearance.LittleGenius.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/parent_weak_topics_title"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_parent_focus_topics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/lg_on_surface"
                        android:textSize="14sp"
                        tools:text="• Computer Basics (40% complete)\n• General Science (43% complete)" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/TextAppearance.LittleGenius.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/parent_subject_perf_title"
                android:textSize="18sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_parent_subjects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_subject_row" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
